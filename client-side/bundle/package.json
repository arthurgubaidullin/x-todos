{
  "name": "@arthurgubaidullin/x-todos",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./web-client": "./dist/web-client.js",
    "./vue-client": "./dist/vue-client.js"
  },
  "scripts": {
    "prebuild": "rm -rf dist node_modules/.tmp/tsconfig.build.tsbuildinfo",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest . --run",
    "lint": "eslint .",
    "prepack": "mkdir -p node_modules && ln -s ../../../node_modules/@x-todos ./node_modules/@x-todos",
    "postpack": "rm -rf ./node_modules/@x-todos"
  },
  "bundleDependencies": [
    "@x-todos/vue-client",
    "@x-todos/vue-client-interface",
    "@x-todos/fetch-client",
    "@x-todos/web-client"
  ],
  "dependencies": {
    "@x-todos/vue-client": "*",
    "@x-todos/vue-client-interface": "*",
    "@x-todos/fetch-client": "*",
    "@x-todos/web-client": "*"
  },
  "devDependencies": {
    "@x-todos/tsconfig": "*",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurgubaidullin/x-todos.git"
  },
  "author": {
    "email": "lapteuh+x-todos@gmail.com",
    "name": "Artur Gubaidullin"
  },
  "license": "MIT",
  "version": "0.1.4",
  "files": [
    "dist"
  ]
}
